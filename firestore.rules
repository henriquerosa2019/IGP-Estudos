rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - id: string (required) - User ID
    //   - name: string (required) - Display name
    //   - email: string (required, email) - User email
    //   - role: string (optional, enum: ['user', 'admin']) - User role
    //
    // Collection: notices
    // Document ID: {noticeId}
    // Fields:
    //   - id: string (required) - Notice ID
    //   - uid: string (required) - Owner UID
    //   - name: string (required) - Notice name
    //   - content: string (required) - Full notice content
    //   - subjects: list (required) - List of Subject objects
    //
    // Collection: plans
    // Document ID: {planId}
    // Fields:
    //   - uid: string (required) - Owner UID
    //   - title: string (required)
    //   - notices: list (required) - List of notice IDs
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    // Support for the app's custom anonymous UID (localUid)
    // WARNING: This is less secure than Firebase Anonymous Auth
    function isAnonDoc(data) {
      return data.uid.startsWith('anon_');
    }

    function canReadDoc(data) {
      return (isAuthenticated() && request.auth.uid == data.uid) || isAnonDoc(data);
    }

    function canWriteDoc(data) {
      return (isAuthenticated() && request.auth.uid == data.uid) || isAnonDoc(data);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Allow users to read/write their own profile
      // If not authenticated, allow if it's an anon profile (risky but matches app logic)
      allow read, write: if isOwner(userId) || (userId.startsWith('anon_'));
    }

    match /notices/{noticeId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }

    match /plans/{planId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }

    match /flashcardReviews/{reviewId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }
  }
}
