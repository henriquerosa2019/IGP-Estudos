rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - id: string (required) - User ID
    //   - name: string (required) - Display name
    //   - email: string (required, email) - User email
    //   - role: string (optional, enum: ['user', 'admin']) - User role
    //
    // Collection: notices
    // Document ID: {noticeId}
    // Fields:
    //   - id: string (required) - Notice ID
    //   - uid: string (required) - Owner UID
    //   - name: string (required) - Notice name
    //   - content: string (required) - Full notice content
    //   - subjects: list (required) - List of Subject objects
    //
    // Collection: plans
    // Document ID: {planId}
    // Fields:
    //   - uid: string (required) - Owner UID
    //   - title: string (required)
    //   - notices: list (required) - List of notice IDs
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "henrique.rosa@poli.ufrj.br" || request.auth.token.email == "brunool.rj@gmail.com");
    }

    // Support for the app's custom anonymous UID (localUid)
    function isAnonDoc(data) {
      return data.uid.startsWith('anon_');
    }

    function canReadDoc(data) {
      return (isAuthenticated() && request.auth.uid == data.uid) || (data.uid != null && (data.uid.startsWith('anon_') || data.uid.size() <= 15)) || isAdmin();
    }

    function canWriteDoc(data) {
      return (isAuthenticated() && request.auth.uid == data.uid) || (data.uid != null && (data.uid.startsWith('anon_') || data.uid.size() <= 15)) || isAdmin();
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId) || userId.startsWith('anon_') || isAdmin();
    }

    match /unauthorized_attempts/{attemptId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /notices/{noticeId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }

    match /plans/{planId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }

    match /flashcardReviews/{reviewId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }

    match /contentItems/{itemId} {
      allow read: if canReadDoc(resource.data);
      allow create: if canWriteDoc(request.resource.data);
      allow update, delete: if canWriteDoc(resource.data);
    }
  }
}
